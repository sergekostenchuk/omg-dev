{
  "name": "omg-product-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild ui/app.tsx --bundle --format=esm --jsx=automatic --outfile=public/app.js",
    "test": "node --test dist/test/*.test.js",
    "check": "npm run build && npm test",
    "start": "node dist/src/cli.js",
    "dev": "npm run build && node dist/src/cli.js serve"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.1",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
